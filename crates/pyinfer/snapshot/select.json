 those.\n\nThe optional 4th argument specifies a timeout in seconds; it may be\na floating-point number to specify fractions of seconds.  If it is absent\nor None, the call will never time out.\n\nThe return value is a tuple of three lists corresponding to the first three\narguments; each contains the subset of the corresponding file descriptors\nthat are ready.\n\n*** IMPORTANT NOTICE ***\nOn Windows, only sockets are supported; on Unix, all file\ndescriptors can be used."}},"body":[]},"locals":{}}]},"locals":{"KQ_EV_ADD":[2],"KQ_EV_CLEAR":[3],"KQ_EV_DELETE":[4],"KQ_EV_DISABLE":[5],"KQ_EV_ENABLE":[6],"KQ_EV_EOF":[7],"KQ_EV_ERROR":[8],"KQ_EV_FLAG1":[9],"KQ_EV_ONESHOT":[10],"KQ_EV_SYSFLAGS":[11],"KQ_FILTER_AIO":[12],"KQ_FILTER_PROC":[13],"KQ_FILTER_READ":[14],"KQ_FILTER_SIGNAL":[15],"KQ_FILTER_TIMER":[16],"KQ_FILTER_VNODE":[17],"KQ_FILTER_WRITE":[18],"KQ_NOTE_ATTRIB":[19],"KQ_NOTE_CHILD":[20],"KQ_NOTE_DELETE":[21],"KQ_NOTE_EXEC":[22],"KQ_NOTE_EXIT":[23],"KQ_NOTE_EXTEND":[24],"KQ_NOTE_FORK":[25],"KQ_NOTE_LINK":[26],"KQ_NOTE_LOWAT":[27],"KQ_NOTE_PCTRLMASK":[28],"KQ_NOTE_PDATAMASK":[29],"KQ_NOTE_RENAME":[30],"KQ_NOTE_REVOKE":[31],"KQ_NOTE_TRACK":[32],"KQ_NOTE_TRACKERR":[33],"KQ_NOTE_WRITE":[34],"PIPE_BUF":[35],"POLLERR":[36],"POLLHUP":[37],"POLLIN":[38],"POLLNVAL":[39],"POLLOUT":[40],"POLLPRI":[41],"POLLRDBAND":[42],"POLLRDNORM":[43],"POLLWRBAND":[44],"POLLWRNORM":[45],"__loader__":[46],"__spec__":[47],"error":[48],"kevent":[49],"kqueue":[138],"poll":[222],"select":[225]},"modname":"select","pure_python":false}